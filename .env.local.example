# Copy this file to .env.local and fill in real values.
# .env.local (and every .env* variant) is gitignored — never commit real keys.

# --- Supabase ---
# Project Settings -> API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, bypasses Row Level Security.
# NEVER expose this to the client or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) ---
# Used server-side only, for lead classification and reply drafting.
# Must be a workspace-scoped key (Console -> API Keys -> pick a workspace,
# not "no workspace"/organization-wide) -- an org-wide key gets rejected
# with "not scoped to a workspace" since we don't send anthropic-workspace-id.
ANTHROPIC_API_KEY=

# --- Approve-and-send (step 5) ---
# Sends the approved reply. Until step 2 connects a real inbox, this is
# literally how leads get replied to -- swap for the real inbox connection
# later without touching src/app/api/leads/[id]/send/route.ts.
# https://resend.com/api-keys
RESEND_API_KEY=
# Defaults to onboarding@resend.dev (Resend's no-verification-required
# sandbox sender) if unset. That sandbox address can only send to the
# email your Resend account itself is registered with, until you verify a
# real sending domain. Format: "you@yourdomain.com" (a display name is
# added automatically from the business's name).
RESEND_FROM_EMAIL=

# --- Inbox OAuth (step 2) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=

# Symmetric key used to encrypt inbox OAuth tokens before storing them in
# inbox_connections.encrypted_tokens. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Reminders (step 6) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Shared secret the reminder cron route checks for, so it can't be
# triggered by an anonymous request (Vercel Cron sends this automatically
# once configured; see vercel.json).
CRON_SECRET=
